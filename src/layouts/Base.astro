---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../assets/favicon.png';
import portrait from '../assets/photos/navin-selfie.jpg';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** False on pages other than the single page, so header links point back to it. */
  home?: boolean;
}

const {
  title,
  description = `${person.fullName}, ${person.role} at ${person.school}. Practical software, AI-powered applications and cybersecurity projects.`,
  home = true,
} = Astro.props;

const fullTitle = title ? `${title} · ${person.displayName}` : `${person.displayName} · Player's guide`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The source favicon is a 1.3 MB PNG; ship small derived versions instead.
const icon32 = await getImage({ src: favicon, width: 32, height: 32, format: 'png' });
const icon180 = await getImage({ src: favicon, width: 180, height: 180, format: 'png' });
const ogImage = await getImage({ src: portrait, width: 1200, format: 'jpg' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={icon32.src} />
    <link rel="apple-touch-icon" href={icon180.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0b17" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <!-- Reveal pre-hiding only when motion is welcome; if scripts never boot,
         everything shows after 3 s. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement;
        root.classList.add('motion-ok');
        setTimeout(() => {
          if (!window.__motionReady) root.classList.remove('motion-ok');
        }, 3000);
      }
    </script>
  </head>
  <body>
    <a class="skip-link key key--primary" href="#main">Skip to content</a>
    <Header home={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import { boot } from '../scripts/main';
      boot();
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .skip-link {
    position: fixed;
    top: var(--s-3);
    left: var(--s-3);
    z-index: 60;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
</style>
