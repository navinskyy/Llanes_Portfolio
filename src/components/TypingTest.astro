---
import Icon from './Icon.astro';
import { typingBenchmark } from '../data/site';

const rows = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'].map((r) => [...r]);
---

<dialog id="typing-dialog" class="dlg tt" data-dialog aria-labelledby="tt-title" aria-describedby="tt-help">
  <div class="tt-card dlg-panel" data-panel>
    <button class="btn btn--icon btn--quiet dlg-close" type="button" data-close aria-label="Close typing test">
      <Icon name="close" />
    </button>
    <h2 id="tt-title">Race Navin</h2>
    <p id="tt-help" class="dlg-sub">
      Type the words for {typingBenchmark.durationSeconds} seconds. The timer starts on your first key. Beat{' '}
      {typingBenchmark.wpm} wpm at {typingBenchmark.accuracy}% accuracy to win.
    </p>

    <dl class="tt-stats" aria-live="off">
      <div><dt>wpm</dt><dd id="tt-wpm">0</dd></div>
      <div><dt>accuracy</dt><dd><span id="tt-acc">100</span><small>%</small></dd></div>
      <div><dt>time left</dt><dd><span id="tt-time">{typingBenchmark.durationSeconds}</span><small>s</small></dd></div>
    </dl>

    <div class="tt-viewport" aria-hidden="true">
      <div class="tt-track" id="tt-track"></div>
    </div>

    <label class="visually-hidden" for="tt-input">Type the words shown</label>
    <input class="tt-input" id="tt-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" />

    <div class="tt-keyboard" aria-hidden="true">
      {
        rows.map((row) => (
          <div class="kb-row">
            {row.map((k) => (
              <span class="kb-key" data-key={k}>{k}</span>
            ))}
          </div>
        ))
      }
      <div class="kb-row"><span class="kb-key kb-space" data-key=" ">space</span></div>
    </div>

    <p class="tt-foot"><kbd>tab</kbd> restart <kbd>esc</kbd> close</p>
  </div>
</dialog>

<dialog id="result-dialog" class="dlg result" data-dialog aria-labelledby="result-title" aria-describedby="result-sub">
  <div class="dlg-panel" data-panel>
    <button class="btn btn--icon btn--quiet dlg-close" type="button" data-close aria-label="Close result">
      <Icon name="close" />
    </button>
    <h2 id="result-title">Result</h2>
    <p class="dlg-sub" id="result-sub"></p>
    <dl class="result-stats">
      <div><dt>your wpm</dt><dd id="result-wpm">0</dd></div>
      <div><dt>accuracy</dt><dd><span id="result-acc">0</span><small>%</small></dd></div>
      <div><dt>navin</dt><dd>{typingBenchmark.wpm}<small> / {typingBenchmark.accuracy}%</small></dd></div>
    </dl>
    <button class="btn btn--primary retry" id="result-retry" type="button"><Icon name="retry" />Try again</button>
  </div>
</dialog>

<style>
  .tt-card {
    width: min(760px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .tt-card .dlg-sub {
    max-width: 52ch;
  }
  .tt-stats,
  .result-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
  }
  .tt-stats > div,
  .result-stats > div {
    padding: var(--s-3) var(--s-4);
    border-left: 1px solid var(--hair);
  }
  .tt-stats > div:first-child,
  .result-stats > div:first-child {
    border-left: 0;
  }
  dt {
    font-family: var(--ff-note);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  dd {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  dd small {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    font-weight: 500;
  }

  .tt-viewport {
    overflow: hidden;
    height: 96px;
  }
  .tt-track {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 48px;
    color: var(--ink-2);
    opacity: 0.75;
    transition: transform 320ms var(--ease-out);
  }
  .tt-track :global(.word) {
    display: inline-block;
    margin-right: 0.55em;
  }
  .tt-track :global(.char) {
    position: relative;
  }
  .tt-track :global(.char.is-correct) {
    color: var(--ink);
  }
  /* Mistakes are redlined: blue, and struck or underlined so the cue
     never rests on colour alone. */
  .tt-track :global(.char.is-incorrect) {
    color: var(--blue);
    text-decoration: underline;
  }
  .tt-track :global(.word.is-correct) {
    opacity: 0.45;
  }
  .tt-track :global(.word.is-wrong) {
    color: var(--blue);
    text-decoration: line-through;
  }
  .tt-track :global(.char.is-caret)::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    background: var(--blue);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .tt-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* The keyboard is drawn in plan: hairline squares, the next key inked blue. */
  .tt-keyboard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .kb-row {
    display: flex;
    gap: 6px;
  }
  .kb-key {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hair);
    font-family: var(--ff-note);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    transition:
      background-color var(--t-fast) ease,
      border-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }
  .kb-key.is-next {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--on-blue);
  }
  .kb-key.is-pressed {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .kb-space {
    width: 280px;
  }
  .tt-foot {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    display: flex;
    gap: var(--s-2);
    align-items: center;
    justify-content: center;
  }
  kbd {
    font-family: var(--ff-note);
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 1px 6px;
    border: 1px solid var(--hair);
  }
  .tt-foot kbd + kbd {
    margin-left: var(--s-4);
  }

  /* A win is set in blue in the title itself. */
  .result[data-outcome='won'] :global(#result-title) {
    color: var(--blue);
  }
  .result-stats {
    margin-block: var(--s-6);
  }
  .result-stats dd {
    font-size: var(--fs-lg);
  }
  .retry {
    width: 100%;
  }

  @media (max-width: 600px) {
    .tt-card {
      padding-inline: var(--s-4);
      gap: var(--s-4);
    }
    .tt-track {
      font-size: 1.0625rem;
    }
    .kb-row {
      gap: 4px;
    }
    .kb-key {
      width: 28px;
      height: 34px;
    }
    .kb-space {
      width: 160px;
    }
  }
</style>
