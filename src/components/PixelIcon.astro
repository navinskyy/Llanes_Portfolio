const colors: Record<string, string> = { o: 'var(--fg)', f: 'var(--panel)', a: accent };
const rects = toRects(art[name], colors);
---

<svg class={className} viewBox="0 0 12 12" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
