---
// Learning: the unexplored region past the map's edge. Open sky with stars, a
// moon and a small planet, two ranges of uneven snow-capped peaks with a flag
// on the highest, a signpost pointing on; fireflies rise and a star falls.
import Scene from './Scene.astro';
import Sprite from './Sprite.astro';
import Strip from './Strip.astro';
import { ridgeTile, seeded, starTile } from '../../lib/pixels';
import { flag, moon, signpost, smallMoon, streak, world as W } from '../../lib/sprites';

const sky = starTile({ seed: 41, size: 192, count: 44, colors: [W.frame, W.frameHi, W.violetDim], bright: W.frameHi });
// A flag planted on the tallest summit of the far range (drawn into the tile,
// so it always stands on the peak). It repeats once every 960px.
const plant = (heights: number[]) => {
  const x = heights.indexOf(Math.max(...heights));
  const top = 48 - heights[x];
  return flag.rects.map((r) => ({ ...r, x: r.x + x, y: r.y + top - flag.h }));
};
const farPeaks = ridgeTile({ w: 320, h: 48, base: 10, amp: 26, peaks: 9, phase: 0.2, seed: 7, fill: W.sil3, snow: W.frame, extra: plant });
const nearPeaks = ridgeTile({ w: 160, h: 24, base: 6, amp: 12, peaks: 5, phase: 0.55, seed: 9, fill: W.sil2, snow: W.edge });
const ground = ridgeTile({ h: 8, base: 4, amp: 1.5, phase: 0.9, fill: W.sil });

const rand = seeded(42);
const motes = Array.from({ length: 9 }, (_, i) => ({
  x: (4 + rand() * 92).toFixed(1),
  y: (8 + rand() * 30).toFixed(1),
  c: i % 3 === 0 ? 'var(--amber)' : 'var(--violet)',
  d: 60 + Math.floor(rand() * 80),
}));
---

<Scene tint="rgb(155 123 255 / 0.08)">
  <div class="set">
    <div class="sky" style={`--img:${sky.url};--s:${sky.w * 3}px`}></div>

    <div class="moon wide" data-depth="1.6"><Sprite pic={moon} px={4} data-float="4" /></div>
    <div class="planet edge" data-depth="1"><Sprite pic={smallMoon} px={4} data-float="6" /></div>
    <Sprite pic={streak} px={3} class="shoot" data-shoot />

    <Strip tile={farPeaks} bottom="20px" data-ground />
    <Strip tile={nearPeaks} px={4} bottom="12px" offset={20} />
    <Sprite pic={signpost} px={4} class="sign edge" />
    <Strip tile={ground} px={4} />

    {
      motes.map((m) => (
        <span class="mote" style={`left:${m.x}%;bottom:${m.y}%;background:${m.c}`} data-rise={m.d} />
      ))
    }
  </div>
</Scene>

<style>
  .set {
    position: absolute;
    inset: 0;
  }
  .sky {
    position: absolute;
    inset: 0;
    background-image: var(--img);
    background-size: var(--s) var(--s);
    image-rendering: pixelated;
    mask-image: linear-gradient(transparent, #000 20%, #000 55%, transparent 85%);
  }
  .moon,
  .planet {
    position: absolute;
  }
  .moon :global(.sprite),
  .planet :global(.sprite) {
    position: relative;
  }
  .moon {
    top: 12%;
    right: max(24px, calc(50% - var(--wrap) / 2 - 20px));
    opacity: 0.75;
  }
  .planet {
    top: 22%;
    left: calc(var(--side) + 24px);
  }
  .set :global(.shoot) {
    top: 8%;
    left: 22%;
  }
  .set :global(.sign) {
    bottom: 28px;
    left: calc(var(--side) + 40px);
  }
  .mote {
    position: absolute;
    width: 4px;
    height: 4px;
  }
</style>
