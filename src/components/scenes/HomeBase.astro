---
// About: the player's home base. A far settlement of towers and domes on the
// horizon, the domed hall itself with a blinking antenna, floating interface
// frames in the margins and a soft violet light from above.
import Scene from './Scene.astro';
import Sprite from './Sprite.astro';
import Strip from './Strip.astro';
import { ridgeTile, skylineTile, tile } from '../../lib/pixels';
import { crosshair, dome, halo, world as W } from '../../lib/sprites';

const dither = tile(8, 8, [
  { x: 0, y: 0, w: 1, fill: 'rgba(155,123,255,0.09)' },
  { x: 4, y: 4, w: 1, fill: 'rgba(155,123,255,0.05)' },
]);
const settlement = skylineTile({
  seed: 11,
  h: 30,
  min: 6,
  max: 22,
  body: W.sil3,
  edge: W.edge,
  windows: [W.violetDim, W.amberDim],
  lit: 0.12,
  beacon: '#6a2e2a',
});
const ground = ridgeTile({ h: 8, base: 4, amp: 1.5, phase: 1.2, fill: W.sil });
---

<Scene tint="rgb(155 123 255 / 0.07)" texture={dither}>
  <div class="set">
    <div class="glow" data-pulse></div>

    <div class="hud hud--a edge" data-depth="1.2"><span></span><span></span><span></span></div>
    <div class="hud hud--b edge" data-depth="0.8"><span></span><span></span></div>
    <Sprite pic={halo} px={4} class="edge halo" data-float="6" />
    <Sprite pic={crosshair} px={4} class="edge cross cross--a" data-float="4" />
    <Sprite pic={crosshair} px={3} class="edge cross cross--b" data-float="6" />
    <div class="rail rail--l edge"></div>
    <div class="rail rail--r edge"></div>

    <Strip tile={settlement} bottom="12px" data-ground />
    <Sprite pic={dome} px={4} class="wide home" blink={['#e86f5f']} />
    <Strip tile={ground} px={4} />
  </div>
</Scene>

<style>
  .set {
    position: absolute;
    inset: 0;
  }
  .glow {
    position: absolute;
    top: -260px;
    right: -160px;
    width: 720px;
    height: 620px;
    background: radial-gradient(closest-side, rgb(155 123 255 / 0.11), transparent);
  }
  /* Floating interface frames: four corner brackets and a few readout bars. */
  .hud {
    position: absolute;
    width: 104px;
    padding: 14px 12px;
    background:
      linear-gradient(var(--frame-hi), var(--frame-hi)) top left / 10px 2px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) top left / 2px 10px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) top right / 10px 2px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) top right / 2px 10px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) bottom left / 10px 2px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) bottom left / 2px 10px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) bottom right / 10px 2px,
      linear-gradient(var(--frame-hi), var(--frame-hi)) bottom right / 2px 10px;
    background-repeat: no-repeat;
    opacity: 0.55;
  }
  /* No display rule on .hud itself: .edge decides whether it shows. */
  .hud span {
    display: block;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--violet-deep) 0 6px, transparent 6px 8px);
  }
  .hud span + span {
    margin-top: 6px;
  }
  .hud span:first-child {
    width: 70%;
    background: var(--violet);
    opacity: 0.5;
  }
  .hud--a {
    top: 16%;
    left: var(--side);
  }
  .hud--b {
    top: 58%;
    right: var(--side);
  }
  .set :global(.halo) {
    top: 44%;
    left: calc(var(--side) + 18px);
    opacity: 0.6;
  }
  .set :global(.cross--a) {
    top: 22%;
    right: calc(var(--side) + 40px);
  }
  .set :global(.cross--b) {
    top: 78%;
    left: calc(var(--side) + 64px);
  }
  /* Pixel rails framing the chapter on wide screens. */
  .rail {
    position: absolute;
    top: 12%;
    bottom: 120px;
    width: 4px;
    background: repeating-linear-gradient(180deg, var(--frame) 0 4px, transparent 4px 12px);
    opacity: 0.6;
  }
  .rail--l {
    left: calc(var(--side) - 4px);
  }
  .rail--r {
    right: calc(var(--side) - 4px);
  }
  .set :global(.home) {
    right: max(16px, calc(50% - var(--wrap) / 2 - 40px));
    bottom: 20px;
    opacity: 0.9;
  }
</style>
