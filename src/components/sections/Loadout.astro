---
// Skills as an equipment screen: one bag per group, one slot per item.
// No levels or bars; a group still being learned is marked Training.
import ChapterHead from './ChapterHead.astro';
import { skills } from '../../data/site';
---

<section id="skills" class="chapter" aria-labelledby="skills-title">
  <div class="wrap">
    <ChapterHead id="skills" />
    <div class="bags" data-reveal>
      {
        skills.map((g) => (
          <div class:list={['bag win', { training: g.training }]}>
            <h3 class="win-bar tag">
              <span>{g.group}</span>
              {g.training ? (
                <span class="status" data-status="Training">
                  Training
                </span>
              ) : (
                <span>{g.items.length}</span>
              )}
            </h3>
            <ul role="list">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bags {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--s-5);
  }
  .bag h3 {
    color: var(--fg);
  }
  .bag ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: var(--s-4);
  }
  .bag li {
    padding: 6px 10px;
    background: var(--bg);
    border: 2px solid var(--frame);
    font-size: var(--fs-sm);
    line-height: 1.3;
  }
  .training li {
    border-style: dashed;
    color: var(--muted);
  }
  /* One bag spans two columns on wide screens so the grid ends flush. */
  @media (min-width: 900px) {
    .bag:first-child {
      grid-column: span 2;
    }
  }
</style>
