---
// Projects. A project with a real screenshot is a featured item with the shot
// at full width; the rest are rows in one item list, each with its drawn icon.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PixelIcon from '../PixelIcon.astro';
import ChapterHead from './ChapterHead.astro';
import PixelCity from '../scenes/PixelCity.astro';
import { projects, type Project } from '../../data/site';

const featured = projects.filter((p) => p.image);
const items = projects.filter((p) => !p.image);

const accent: Record<Project['icon'], string> = {
  cross: 'var(--red)',
  book: 'var(--blue)',
  tooth: 'var(--fg)',
  shield: 'var(--green)',
  cup: 'var(--amber)',
  receipt: 'var(--amber)',
};
---

<section id="projects" class="chapter" aria-labelledby="projects-title">
  <PixelCity />
  <div class="wrap">
    <ChapterHead id="projects" />

    {
      featured.map((p) => (
        <article class="feature" aria-labelledby={`p-${p.icon}`} data-reveal>
          <a class="shot win" href={p.demo ?? p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <span class="win-bar tag">
              <span>{p.demo ? new URL(p.demo).host : p.name}</span>
              <span>Screenshot</span>
            </span>
            <Picture
              src={p.image!.src}
              formats={['avif', 'webp']}
              widths={[560, 900, 1400]}
              sizes="(max-width: 980px) 100vw, 720px"
              alt={p.image!.alt}
            />
          </a>

          <div class="feature-body">
            <div class="name-row">
              <PixelIcon name={p.icon} accent={accent[p.icon]} class="icon" />
              <h3 id={`p-${p.icon}`} class="pixel">{p.name}</h3>
            </div>
            <p class="kind">
              {p.status && <span class="status tag" data-status={p.status}>{p.status}</span>}
              <span>{p.kind}</span>
            </p>
            <dl class="spec">
              <div>
                <dt class="tag">Problem</dt>
                <dd>{p.problem}</dd>
              </div>
              <div>
                <dt class="tag">What it does</dt>
                <dd>{p.description}</dd>
              </div>
              <div>
                <dt class="tag">Built with</dt>
                <dd>{p.tech.join(' · ')}</dd>
              </div>
            </dl>
            <p class="actions">
              {p.demo && (
                <a class="key key--primary" href={p.demo} target="_blank" rel="noopener noreferrer">
                  Live site <Icon name="arrow" />
                  <span class="visually-hidden"> {p.name} (opens in a new tab)</span>
                </a>
              )}
              {p.url && (
                <a class="key" href={p.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" /> Source
                  <span class="visually-hidden"> code for {p.name} (opens in a new tab)</span>
                </a>
              )}
            </p>
          </div>
        </article>
      ))
    }

    <div class="list win" data-reveal>
      <p class="win-bar tag"><span>Items</span><span>{items.length} more</span></p>
      <ol role="list">
        {
          items.map((p) => (
            <li class="item" data-reveal-item>
              <div class="slot" aria-hidden="true">
                <PixelIcon name={p.icon} accent={accent[p.icon]} />
              </div>
              <div class="item-main">
                <div class="item-head">
                  <h3 class="pixel">{p.name}</h3>
                  {p.status && (
                    <span class="status tag" data-status={p.status}>
                      {p.status}
                    </span>
                  )}
                </div>
                <p class="kind">{p.kind}</p>
                <p class="problem">{p.problem}</p>
                <p class="desc">{p.description}</p>
              </div>
              <div class="item-side">
                {p.figure && (
                  <p class="figure">
                    <span class="pixel">{p.figure.value}</span>
                    <span class="tag">{p.figure.label}</span>
                  </p>
                )}
                {p.tech.length > 0 && (
                  <p class="meta">
                    <span class="tag">Built with</span>
                    <span>{p.tech.join(' · ')}</span>
                  </p>
                )}
                {p.role && (
                  <p class="meta">
                    <span class="tag">Role</span>
                    <span>{p.role}</span>
                  </p>
                )}
                {p.url ? (
                  <a class="link" href={p.url} target="_blank" rel="noopener noreferrer">
                    Source on GitHub <Icon name="arrow" />
                    <span class="visually-hidden"> for {p.name} (opens in a new tab)</span>
                  </a>
                ) : (
                  <p class="meta private">No public link yet</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* ---------- featured ---------- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: var(--s-10);
    align-items: start;
    margin-bottom: var(--s-16);
  }
  .shot {
    display: block;
    text-decoration: none;
    background: var(--bg-deep);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    transition: filter var(--t-base) ease;
  }
  .shot:hover {
    border-color: var(--amber);
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .name-row :global(.icon) {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }
  .feature h3 {
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem);
    font-weight: 600;
  }
  .kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .spec {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .spec dt {
    color: var(--amber);
    margin-bottom: var(--s-1);
  }
  .spec dd {
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  /* ---------- item list ---------- */
  .list ol {
    padding: var(--s-2) 0;
  }
  .item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--s-6);
    padding: var(--s-6);
    transition: background-color var(--t-fast) steps(2);
  }
  .item + .item {
    border-top: 2px dashed var(--frame);
  }
  .item:hover {
    background: var(--panel-2);
  }
  .slot {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    background: var(--bg);
    border: 2px solid var(--frame);
  }
  .item:hover .slot {
    border-color: var(--amber);
  }
  .slot :global(svg) {
    width: 48px;
    height: 48px;
  }
  .item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
  }
  .item h3 {
    font-size: var(--fs-xl);
    font-weight: 600;
  }
  .item .kind {
    margin-top: var(--s-1);
  }
  .problem {
    margin-top: var(--s-3);
    color: var(--fg);
  }
  .desc {
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .item-side {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-3);
    font-size: var(--fs-sm);
  }
  .meta {
    display: grid;
    gap: 2px;
  }
  .meta .tag {
    color: var(--faint);
  }
  .private {
    color: var(--faint);
  }
  .figure {
    display: grid;
    gap: var(--s-1);
  }
  .figure .pixel {
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--green);
  }
  .figure .tag {
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .feature {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .item {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: var(--s-4) var(--s-5);
      padding: var(--s-5) var(--s-4);
    }
    .slot {
      width: 56px;
      height: 56px;
    }
    .slot :global(svg) {
      width: 36px;
      height: 36px;
    }
    .item-side {
      grid-column: 2;
    }
  }
</style>
