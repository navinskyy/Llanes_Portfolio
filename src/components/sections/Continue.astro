---
// Contact: the guide's last page. Real channels only; no form, because
// nothing would send it.
import Icon from '../Icon.astro';
import PixelAvatar from '../PixelAvatar.astro';
import ChapterHead from './ChapterHead.astro';
import FinalDestination from '../scenes/FinalDestination.astro';
import { person, socials } from '../../data/site';
---

<section id="contact" class="chapter" aria-labelledby="contact-title">
  <FinalDestination />
  <div class="wrap">
    <ChapterHead id="contact" />
    <div class="grid" data-reveal>
      <div>
        <p class="lead pixel">Email is the fastest way to reach me.</p>
        <a class="address" href={`mailto:${person.email}`} data-sfx="select">{person.email}</a>
        <div class="row">
          <a class="key key--primary" href={`mailto:${person.email}`}><Icon name="mail" />Send an email</a>
          <button class="key copy" type="button" data-copy-email={person.email} data-copy-status="copy-status">
            <Icon name="copy" class="i-copy" />
            <Icon name="check" class="i-check" />
            Copy address
          </button>
        </div>
        <p id="copy-status" class="copy-status mono" role="status" aria-live="polite"></p>

        <ul class="channels" role="list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.icon} />
                  <span>{s.label}</span>
                  <span class="handle mono">{s.handle}</span>
                  <Icon name="arrow" class="go" />
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={person.phoneHref}>
              <Icon name="phone" />
              <span>Phone</span>
              <span class="handle mono">{person.phone}</span>
              <span></span>
            </a>
          </li>
          {
            person.resume && (
              <li>
                <a href={person.resume} download>
                  <Icon name="file" />
                  <span>Résumé</span>
                  <span class="handle mono">PDF</span>
                  <Icon name="arrow" class="go" />
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div class="terminal win" aria-label="Closing message">
        <p class="win-bar tag"><span>Save file</span><span>Slot 01</span></p>
        <div class="screen mono">
          <PixelAvatar class="mini" crop="head" />
          <p><span class="dim">&gt;</span> Thanks for reading the guide.</p>
          <p><span class="dim">&gt;</span> Progress saved.</p>
          <p><span class="dim">&gt;</span> Open to internships and junior front-end roles.</p>
          <p class="ready"><span class="dim">&gt;</span> Continue?<span class="cursor" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Room below the content for the skyline the guide ends on. */
  section {
    padding-bottom: calc(var(--s-24) + 120px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--s-16);
    align-items: start;
  }
  .lead {
    font-size: var(--fs-xl);
  }
  .address {
    display: inline-block;
    margin-top: var(--s-4);
    font-family: var(--ff-pixel);
    font-size: clamp(1.375rem, 0.8rem + 2.4vw, 2.75rem);
    line-height: 1.15;
    color: var(--amber);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--amber) 35%, transparent);
    text-underline-offset: 0.18em;
  }
  .address:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .copy :global(.i-check),
  .copy[data-state='copied'] :global(.i-copy) {
    display: none;
  }
  .copy[data-state='copied'] :global(.i-check) {
    display: block;
  }
  .copy[data-state='copied'] {
    color: var(--green);
    border-color: var(--green);
  }
  .copy-status {
    min-height: 1.5em;
    margin-top: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--green);
  }
  .channels {
    margin-top: var(--s-6);
    max-width: 520px;
  }
  .channels li + li {
    border-top: 2px dashed var(--frame);
  }
  .channels a {
    display: grid;
    grid-template-columns: 18px 1fr auto 14px;
    align-items: center;
    gap: var(--s-4);
    min-height: 52px;
    text-decoration: none;
    transition: color var(--t-fast) steps(2);
  }
  .channels a:hover {
    color: var(--amber);
  }
  .channels :global(svg) {
    width: 16px;
    height: 16px;
  }
  .channels :global(.go) {
    width: 12px;
    height: 12px;
    color: var(--faint);
  }
  .handle {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .terminal {
    background: var(--bg-deep);
  }
  .screen {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-6);
    font-size: var(--fs-sm);
    color: var(--green);
    background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.02) 0 1px, transparent 1px 3px);
  }
  .screen :global(.mini) {
    width: 68px;
    height: 68px;
    margin-bottom: var(--s-3);
  }
  .dim {
    color: var(--faint);
  }
  .ready {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--amber);
  }
  .cursor {
    width: 8px;
    height: 1.1em;
    margin-left: 4px;
    background: var(--amber);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-10);
    }
  }
</style>
