---
import Icon from './Icon.astro';
import { person } from '../data/site';
---

<dialog id="email-dialog" class="dlg" data-dialog aria-labelledby="email-title">
  <div class="dlg-panel sheet" data-panel>
    <button class="cap cap--square dlg-close" type="button" data-close aria-label="Close">
      <Icon name="close" />
    </button>
    <h2 id="email-title">Get in touch</h2>
    <p class="dlg-sub">Say hello. I'd love to hear from you.</p>
    <div class="email-field">
      <span class="tabular email-text">{person.email}</span>
      <button class="cap cap--square copy" id="copy-email-btn" type="button" data-email={person.email} aria-label="Copy email address">
        <Icon name="copy" class="i-copy" />
        <Icon name="check" class="i-check" />
      </button>
    </div>
    <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
    <a class="cap cap--accent open-mail" href={`mailto:${person.email}`}>
      <Icon name="mail" />
      Open email app
    </a>
  </div>
</dialog>

<style is:global>
  .dlg {
    border: 0;
    padding: var(--s-4);
    background: transparent;
    color: var(--legend);
    max-width: 100vw;
    max-height: 100dvh;
    margin: auto;
    overflow: visible;
  }
  .dlg::backdrop {
    background: rgb(10 12 15 / 0.55);
  }
  .dlg-panel {
    position: relative;
    width: min(400px, calc(100vw - 2rem));
    padding: var(--s-8) var(--s-6) var(--s-6);
    box-shadow: 0 16px 28px -10px rgb(0 0 0 / 0.3);
  }
  .dlg h2 {
    font-family: var(--ff-legend);
    font-weight: 400;
    font-size: var(--fs-xl);
    padding-right: var(--s-12);
  }
  .dlg-sub {
    margin-top: var(--s-2);
    color: var(--legend-muted);
    font-size: var(--fs-sm);
  }
  .dlg-close {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
  }
</style>

<style>
  .email-field {
    margin-top: var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-cap);
    background: var(--alpha);
  }
  .email-text {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--fs-sm);
    user-select: all;
  }
  .copy .i-check {
    display: none;
  }
  .copy[data-state='copied'] .i-copy {
    display: none;
  }
  .copy[data-state='copied'] .i-check {
    display: block;
    color: var(--accent-text);
  }
  .copy-status {
    min-height: 1.5em;
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--legend-muted);
  }
  .open-mail {
    width: 100%;
    justify-content: center;
    font-family: var(--ff-body);
    font-weight: 700;
    font-size: var(--fs-sm);
    letter-spacing: 0;
  }
</style>
