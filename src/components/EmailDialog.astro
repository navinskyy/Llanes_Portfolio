---
import Icon from './Icon.astro';
import { person } from '../data/site';
---

<dialog id="email-dialog" class="dlg" data-dialog aria-labelledby="email-title">
  <div class="dlg-panel" data-panel>
    <button class="btn btn--icon btn--quiet dlg-close" type="button" data-close aria-label="Close">
      <Icon name="close" />
    </button>
    <h2 id="email-title">Get in touch</h2>
    <p class="dlg-sub">Say hello. I'd love to hear from you.</p>
    <div class="email-field">
      <span class="email-text">{person.email}</span>
      <button class="btn btn--icon copy" id="copy-email-btn" type="button" data-email={person.email} aria-label="Copy email address">
        <Icon name="copy" class="i-copy" />
        <Icon name="check" class="i-check" />
      </button>
    </div>
    <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
    <a class="btn btn--primary open-mail" href={`mailto:${person.email}`}>
      <Icon name="mail" />
      Open email app
    </a>
  </div>
</dialog>

<style is:global>
  .dlg {
    border: 0;
    padding: var(--s-4);
    background: transparent;
    color: var(--ink);
    max-width: 100vw;
    max-height: 100dvh;
    margin: auto;
    overflow: visible;
  }
  .dlg::backdrop {
    background: var(--scrim);
  }
  /* A dialog is a loose sheet laid over the set: a border line, no radius, no shadow. */
  .dlg-panel {
    position: relative;
    width: min(440px, calc(100vw - 2rem));
    padding: var(--s-8) var(--s-6) var(--s-6);
    background: var(--paper);
    border: var(--w-heavy) solid var(--line);
  }
  .dlg h2 {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    padding-right: var(--s-12);
  }
  .dlg-sub {
    margin-top: var(--s-2);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .dlg-close {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
  }
</style>

<style>
  .email-field {
    margin-top: var(--s-6);
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line);
  }
  .email-text {
    flex: 1;
    min-width: 0;
    align-self: center;
    padding: var(--s-2) var(--s-4);
    overflow-wrap: anywhere;
    font-size: var(--fs-sm);
    font-weight: 600;
    user-select: all;
  }
  .copy {
    border: 0;
    border-left: 1px solid var(--line);
  }
  .copy .i-check {
    display: none;
  }
  .copy[data-state='copied'] .i-copy {
    display: none;
  }
  .copy[data-state='copied'] .i-check {
    display: block;
  }
  .copy-status {
    min-height: 1.5em;
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .open-mail {
    width: 100%;
  }
</style>
