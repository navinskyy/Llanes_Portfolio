---
import Icon from './Icon.astro';
import { sections, typingBenchmark } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === href;
---

<header class="board" data-board>
  <div class="board-inner">
    <a class="cap cap--mod brand" href="/" data-shortcut="h" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand-mark">navin<span class="dot">.</span></span>
      <kbd class="legend-sub" aria-hidden="true">H</kbd>
      <span class="visually-hidden">Home</span>
    </a>

    <nav class="keys" aria-label="Sections">
      {
        sections.map((s) => (
          <a
            class="cap key"
            href={s.href}
            data-shortcut={s.key.toLowerCase()}
            aria-current={isCurrent(s.href) ? 'page' : undefined}
            aria-keyshortcuts={s.key}
          >
            <kbd class="key-letter" aria-hidden="true">{s.key}</kbd>
            <span class="key-label">{s.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button class="cap cap--accent race" type="button" data-open="typing" data-shortcut="t" aria-keyshortcuts="T">
        <span>Race me</span>
        <span class="tabular race-wpm">{typingBenchmark.wpm} wpm</span>
      </button>
      <button class="cap cap--square theme" type="button" data-theme-toggle aria-label="Switch to dark colorway">
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
    </div>
  </div>
</header>

<style>
  .board {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--alpha) 92%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  @supports (backdrop-filter: blur(1px)) {
    .board {
      background: color-mix(in oklab, var(--alpha) 80%, transparent);
      backdrop-filter: blur(10px) saturate(1.2);
    }
  }
  .board-inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: var(--s-3) var(--gutter) calc(var(--s-3) + 2px);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
  }

  .brand {
    gap: var(--s-3);
  }
  .brand-mark {
    font-size: 0.9375rem;
    letter-spacing: 0;
  }
  .brand .dot {
    color: var(--accent-on-mod);
  }
  .legend-sub {
    font-family: var(--ff-legend);
    font-size: var(--fs-xs);
    opacity: 0.7;
  }

  .keys {
    display: flex;
    gap: var(--s-2);
    justify-content: center;
  }
  /* Keycap legend layout: letter printed top-left, label beneath. */
  .key {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    min-width: 7.5rem;
    padding-block: var(--s-1) calc(var(--s-1) + 4px);
    line-height: 1.3;
  }
  .key-letter {
    font-family: var(--ff-legend);
    font-size: var(--fs-sm);
    color: var(--legend);
  }
  .key-label {
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0;
  }
  .key[aria-current='page'] {
    --cap-bg: var(--modifier);
    --cap-fg: var(--legend-on-mod);
    --cap-lip: #1d222a;
    border-color: var(--modifier);
  }
  .key[aria-current='page'] .key-letter {
    color: var(--accent-on-mod);
  }
  .brand[aria-current='page'] .legend-sub {
    color: var(--accent-on-mod);
    opacity: 1;
  }

  .tools {
    display: flex;
    gap: var(--s-2);
  }
  .race {
    font-family: var(--ff-body);
    font-weight: 700;
    font-size: var(--fs-sm);
    letter-spacing: 0;
  }
  .race-wpm {
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .theme :global(.icon-sun) {
    display: none;
  }
  :global([data-theme='dark']) .theme :global(.icon-sun) {
    display: block;
  }
  :global([data-theme='dark']) .theme :global(.icon-moon) {
    display: none;
  }

  @media (max-width: 900px) {
    .board-inner {
      grid-template-columns: auto 1fr;
      row-gap: var(--s-3);
    }
    .tools {
      justify-self: end;
    }
    .keys {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr) 1.35fr;
      gap: 6px;
    }
    .key {
      min-width: 0;
      padding-inline: var(--s-2);
    }
  }
  @media (max-width: 520px) {
    .key {
      align-items: center;
      padding-inline: var(--s-1);
    }
    .key-label {
      font-size: var(--fs-xs);
    }
    .race-wpm,
    .legend-sub {
      display: none;
    }
  }
</style>
