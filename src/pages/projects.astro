---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/site';
---

<Base title="Projects" description="Projects by Navin Byron Llanes: an AI library system, an IoT intrusion detection model, and mobile apps.">
  <header class="page-head">
    <h1>Things I've built</h1>
    <p>Projects with a public repository link straight to the code on GitHub.</p>
  </header>

  <ol class="projects" role="list" data-reveal-group>
    {
      projects.map((p) => (
        <li class="project" data-reveal>
          <div class="body">
            <h2>{p.name}</h2>
            <p class="cat">{p.category}</p>
            <p class="desc">{p.description}</p>
          </div>
          <div class="side">
            {p.figure && (
              <p class="figure">
                <span class="tabular">{p.figure.value}</span>
                <span class="figure-label">{p.figure.label}</span>
              </p>
            )}
            {p.url ? (
              <a class="cap repo" href={p.url} target="_blank" rel="noopener noreferrer">
                <Icon name="github" />
                View code
                <span class="visually-hidden"> for {p.name} on GitHub (opens in a new tab)</span>
              </a>
            ) : (
              <p class="private">Repository not public</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .projects {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--s-8);
    padding-block: var(--s-8);
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    font-family: var(--ff-legend);
    font-weight: 400;
    font-size: var(--fs-xl);
    letter-spacing: -0.01em;
  }
  .cat {
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--legend-muted);
  }
  .desc {
    margin-top: var(--s-4);
    max-width: var(--measure);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--s-4);
  }
  .figure {
    display: flex;
    flex-direction: column;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-cap);
    background: var(--panel);
    width: 100%;
  }
  .figure .tabular {
    font-size: var(--fs-xl);
    font-weight: 600;
  }
  .figure-label {
    font-size: var(--fs-sm);
    color: var(--legend-muted);
  }
  .repo {
    justify-content: center;
    font-family: var(--ff-body);
    font-weight: 700;
    font-size: var(--fs-sm);
    letter-spacing: 0;
  }
  .private {
    font-size: var(--fs-sm);
    color: var(--legend-muted);
    text-align: center;
    padding: var(--s-3);
    border: 1px dashed var(--rule);
    border-radius: var(--r-cap);
  }

  @media (max-width: 760px) {
    .project {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
