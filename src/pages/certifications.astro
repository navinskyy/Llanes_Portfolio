---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { honors, certificates, type Certificate } from '../data/site';

const groups: { id: string; title: string; items: Certificate[] }[] = [
  { id: 'honors', title: 'Academic honors', items: honors },
  { id: 'seminars', title: 'Technical certifications & seminars', items: certificates },
];
---

<Base title="Certifications" description="Academic honors, technical certifications and seminars of Navin Byron Llanes, 2023–2026.">
  <header class="page-head">
    <h1>Certifications &amp; seminars</h1>
    <p>Professional certifications, seminars, and workshops that show my continuous learning.</p>
  </header>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={`cg-${g.id}`}>
        <h2 id={`cg-${g.id}`}>
          {g.title} <span class="tabular count">{String(g.items.length).padStart(2, '0')}</span>
        </h2>
        <ul class="plates" role="list" data-reveal-group>
          {g.items.map((c) => (
            <li class="plate" data-reveal>
              <a class="plate-img" href={c.image.src} target="_blank" rel="noopener" aria-label={`View full size: ${c.title} (opens in a new tab)`}>
                <Image src={c.image} alt={c.alt} widths={[320, 480, 720]} sizes="(max-width: 640px) 100vw, 360px" loading="lazy" />
              </a>
              <h3>{c.title}</h3>
              <dl class="spec">
                <div>
                  <dt>Issued</dt>
                  <dd class="tabular">{c.date}</dd>
                </div>
                <div>
                  <dt>Type</dt>
                  <dd>{c.kind}</dd>
                </div>
                {c.details?.map((d) => (
                  <div>
                    <dt>{d.label}</dt>
                    <dd class="tabular">{d.value}</dd>
                  </div>
                ))}
              </dl>
              {c.verifyUrl && (
                <a class="verify" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
                  Verify <Icon name="arrow" />
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .group + .group {
    margin-top: var(--s-16);
  }
  h2 {
    font-family: var(--ff-legend);
    font-weight: 400;
    font-size: var(--fs-xl);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .count {
    margin-left: var(--s-2);
    white-space: nowrap;
    font-size: var(--fs-sm);
    color: var(--legend-muted);
  }
  .plates {
    list-style: none;
    padding: 0;
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--s-6);
  }
  /* A printed kit-sheet plate: flat, hairline-framed, spec fields below. */
  .plate {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-3) var(--s-4);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
  }
  .plate-img {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--alpha);
    overflow: hidden;
  }
  .plate-img :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: var(--s-2);
    transition: transform var(--t-slow) var(--ease-out);
  }
  .plate-img:hover :global(img) {
    transform: scale(1.03);
  }
  h3 {
    padding-inline: var(--s-1);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.35;
  }
  .spec {
    margin-top: auto;
    border-top: 1px solid var(--rule);
  }
  .spec > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-2) var(--s-1);
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-sm);
  }
  .spec dt {
    font-family: var(--ff-legend);
    font-size: var(--fs-xs);
    color: var(--legend-muted);
    padding-top: 2px;
  }
  .verify {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .verify :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
