---
import Base from '../layouts/Base.astro';
import { sheets } from '../data/site';
---

<Base title="Sheet not found" description="This page does not exist." indexBase="/">
  <section class="missing" aria-labelledby="missing-title">
    <h1 id="missing-title">Nothing is drawn here.</h1>
    <p class="lede">Sheet 404 isn't in this set. These are the sheets that are:</p>
    <ul class="links" role="list">
      {
        sheets.map((s) => (
          <li>
            <a class="btn" href={`/#${s.id}`}>
              <span class="note">{s.no}</span> {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .missing {
    min-height: calc(100svh - 2 * var(--frame) - var(--bar) - 2px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--s-16) var(--pad);
  }
  h1 {
    font-size: var(--fs-sheet);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .lede {
    margin-top: var(--s-4);
    color: var(--ink-2);
    font-size: var(--fs-lg);
  }
  .links {
    margin-top: var(--s-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .links .note {
    color: inherit;
  }
</style>
