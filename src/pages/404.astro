---
import Base from '../layouts/Base.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import { sections } from '../data/site';
---

<Base title="Page not found" description="This page does not exist." home={false}>
  <section class="wrap nf">
    <PixelAvatar class="face" />
    <h1 class="pixel">404: area not found</h1>
    <p class="lede">This page doesn't exist. It may have moved when the site became one page. Warp to:</p>
    <ul class="links" role="list">
      <li><a class="key key--primary" href="/">Start</a></li>
      {sections.map((s) => <li><a class="key" href={`/#${s.id}`}>{s.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--s-24);
  }
  .nf :global(.face) {
    width: 96px;
    height: 96px;
  }
  h1 {
    margin-top: var(--s-6);
    font-size: var(--fs-h2);
    font-weight: 600;
  }
  .lede {
    margin-top: var(--s-3);
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-8);
  }
</style>
