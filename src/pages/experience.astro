---
import Base from '../layouts/Base.astro';
import { experience } from '../data/site';
---

<Base title="Experience" description="Work and leadership experience of Navin Byron Llanes: H&M, Lyceum Pirate Esports Organization, and work immersion.">
  <header class="page-head">
    <h1>Where I've worked</h1>
    <p>Work alongside my studies, and leadership roles in student organizations.</p>
  </header>

  <ol class="roles" role="list" data-reveal-group>
    {
      experience.map((r) => (
        <li class="role" data-reveal>
          <p class="band tabular">
            <time>{r.start}</time>
            <span aria-hidden="true">→</span>
            <span class="visually-hidden">to</span>
            <span class:list={['end', { 'is-now': r.end === 'Present' }]}>{r.end}</span>
          </p>
          <div>
            <h2>{r.title}</h2>
            <p class="org">
              {r.org} · {r.place}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .roles {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .role {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--s-8);
    align-items: baseline;
    padding-block: var(--s-8);
    border-bottom: 1px solid var(--rule);
  }
  .band {
    display: flex;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--legend-muted);
  }
  .is-now {
    color: var(--legend-on-mod);
    font-weight: 600;
    padding: 0 var(--s-2);
    border-radius: 4px;
    background: var(--modifier);
  }
  h2 {
    font-family: var(--ff-legend);
    font-weight: 400;
    font-size: var(--fs-lg);
  }
  .org {
    margin-top: var(--s-2);
    color: var(--legend-muted);
  }
  @media (max-width: 700px) {
    .role {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    /* Title leads; the date band follows as a spec field. */
    .band {
      order: 2;
      padding-top: var(--s-2);
      border-top: 1px dashed var(--rule);
    }
  }
</style>
